// Installable alongside both the App Store app and the local development app.
AGENT_PREVIEW_BUNDLE_Bex = dev.remoteagent.mobile.ios.preview
AGENT_PREVIEW_BUNDLE_TaskActivityExtension = dev.remoteagent.mobile.ios.preview.TaskActivity
AGENT_PREVIEW_BUNDLE_UITests = dev.remoteagent.mobile.ios.preview.uitests
PRODUCT_BUNDLE_IDENTIFIER = $(AGENT_PREVIEW_BUNDLE_$(TARGET_NAME))
AGENT_PREVIEW_PRODUCT_Bex = BEX Preview
AGENT_PREVIEW_PRODUCT_TaskActivityExtension = TaskActivityExtension
AGENT_PREVIEW_PRODUCT_UITests = UITests
PRODUCT_NAME = $(AGENT_PREVIEW_PRODUCT_$(TARGET_NAME))
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconPreview
AGENT_TASK_URL_SCHEME = bex-preview
