          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hourly removes worktrees with no commits beyond the default branch. Worktrees that are running, awaiting an answer, used by a terminal or have local changes are skipped. Branches and conversation history are kept."
          }
        }
      }
    },
