# As the window narrows, the composer's controls step aside as T3 Code's footer
# does: the approval control shows only its icon, then moves into the "more"
# control's menu while the model's name shortens, and last the controls hide.
# Attaching, dictation and sending stay, and nothing is cut off.
fixture /long-conversation/composer-narrow
expect "検証プロジェクト" 30000
press 検証プロジェクト
press "Long conversation" 20000
expect "Review section 14, input 0." 20000
expect "カスタム・未設定"
window 660 760
expect_absent "カスタム・未設定"
expect_inside 送信
expect_inside ファイルを添付
expect_inside 承認方法を変更
expect_inside "Fixture Model"
expect_inside 音声をCodexで文字起こし
expect_inside "AI に依頼する"
screenshot icon
press 承認方法を変更
expect "承認を求める"
key escape
expect_absent "承認を求める"
# The approval control moves into the "more" menu; the model's name shortens.
window 540 760
expect その他
expect_absent 承認方法を変更
expect_inside 送信
expect_inside ファイルを添付
expect_inside その他
expect_inside "Fixture Model"
expect_inside 音声をCodexで文字起こし
# The shortened name stays within its control, clear of its neighbours.
expect_apart "Fixture Model" 音声をCodexで文字起こし
expect_apart "Fixture Model" その他
screenshot more
press その他
expect "承認を求める"
expect "フルアクセス"
key escape
expect_absent "承認を求める"
# Last, the controls hide.
window 480 760
expect_absent その他
expect_absent "Fixture Model"
expect_inside 送信
expect_inside ファイルを添付
expect_inside 音声をCodexで文字起こし
screenshot hidden
# Wide again, everything comes back with its label.
window 1200 760
expect "カスタム・未設定"
expect "Fixture Model"
screenshot wide
