# The model picker opens from the composer, lists the provider's models, applies
# one to the composer and closes with Escape. As in the GPUI client, choosing a
# model keeps the picker open.
# iOS: testSimulatorModelPickerUsesNativeFormAndAgentPicker
expect "何に取り組みますか？" 30000
press モデル
expect "Fixture Model" 20000
expect "モデルを検索"
expect "Claude Code"
screenshot picker
press "Fixture Model"
key escape
expect_absent "モデルを検索"
expect "Fixture Model"
screenshot applied
