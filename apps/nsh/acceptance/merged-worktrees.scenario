# Conversations whose worktree is merged say so beside their running status.
# iOS: testSimulatorMarksMergedWorktreesToTheRightOfRunningStatus
fixture /merge-worktree/fresh
fixture /merge-worktree/merged
expect "検証プロジェクト" 30000
press 検証プロジェクト
expect "Merged running task" 20000
expect "実行中、main にマージ済み"
expect "Merged idle task"
expect "main にマージ済み" after "Merged idle task"
screenshot merged
