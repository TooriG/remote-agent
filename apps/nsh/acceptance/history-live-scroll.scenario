# A reader who scrolled a little way up stays there while a turn streams in,
# as T3 Code's timeline stops following on a scroll toward the start; back at
# the end, the conversation follows again.
# iOS: HistoryUITests.testSimulatorKeepsSmallOlderScrollDuringLiveUpdate
fixture /long-conversation/long-history
expect "検証プロジェクト" 30000
press 検証プロジェクト
press "Long conversation" 20000
expect "Review section 14, input 0." 20000
expect_scrolled この会話 0.99 1 10000
type "AI に依頼する" "読んでいる間に届きます"
press 送信
expect "シミュレータで確認しています…" 30000
scroll この会話 -4
expect_scrolled この会話 0 0.999 10000
expect "シミュレータで完了しました。" 30000
expect_scrolled この会話 0 0.999
screenshot kept-place
scroll この会話 400
expect_scrolled この会話 0.99 1 10000
